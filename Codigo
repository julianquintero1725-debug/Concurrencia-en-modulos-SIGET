// =====================================================================
// SIGET - Simulacion de Concurrencia: Productor-Consumidor
// Escenario: sensores de trafico (productores) generan datos que se
// almacenan en un buffer compartido; el modulo de analisis (consumidor)
// los procesa. Se usan semaforos para evitar perdida o corrupcion de
// informacion (condiciones de carrera).
// =====================================================================

#include <iostream>
#include <thread>
#include <queue>
#include <semaphore>
#include <chrono>
#include <random>
#include <mutex>

// --- Configuracion de la simulacion ---
const int TAM_BUFFER = 5;        // Capacidad maxima del buffer compartido
const int DATOS_POR_SENSOR = 5;  // Cuantos datos genera cada sensor
const int NUM_SENSORES = 2;      // Cantidad de sensores (productores)

// --- Recursos compartidos ---
std::queue<int> buffer;          // Buffer compartido entre sensores y analisis
std::mutex mtx;                  // Candado para proteger el acceso al buffer

// --- Semaforos ---
// espacios_vacios: cuenta cuantos "huecos" libres hay en el buffer.
//   Empieza en TAM_BUFFER (todo vacio). Los sensores lo "esperan"
//   antes de escribir, y el modulo de analisis lo "libera" al leer.
std::counting_semaphore<TAM_BUFFER> espacios_vacios(TAM_BUFFER);

// espacios_llenos: cuenta cuantos datos hay listos para procesar.
//   Empieza en 0 (nada que leer). El modulo de analisis lo "espera"
//   antes de leer, y los sensores lo "liberan" al escribir.
std::counting_semaphore<TAM_BUFFER> espacios_llenos(0);

// --- Sensor de trafico (productor) ---
void sensor(int id) {
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_int_distribution<> dist(1, 100); // dato simulado (ej. vehiculos/min)

    for (int i = 1; i <= DATOS_POR_SENSOR; i++) {
        int dato = dist(gen);

        espacios_vacios.acquire();   // espera a que haya espacio libre en el buffer
        mtx.lock();                  // entra en zona critica: nadie mas puede tocar el buffer
        buffer.push(dato);
        std::cout << "[Sensor " << id << "] genero dato #" << i
                  << " = " << dato
                  << "  (buffer: " << buffer.size() << "/" << TAM_BUFFER << ")\n";
        mtx.unlock();                // sale de zona critica
        espacios_llenos.release();   // avisa que hay un dato nuevo disponible para el analisis

        std::this_thread::sleep_for(std::chrono::milliseconds(300 + id * 150));
    }
    std::cout << "[Sensor " << id << "] termino de enviar datos.\n";
}

// --- Modulo de analisis (consumidor) ---
void modulo_analisis() {
    int total_esperado = NUM_SENSORES * DATOS_POR_SENSOR;
    int procesados = 0;

    while (procesados < total_esperado) {
        espacios_llenos.acquire();   // espera a que haya al menos un dato disponible
        mtx.lock();                  // entra en zona critica
        int dato = buffer.front();
        buffer.pop();
        procesados++;
        std::cout << "    [Analisis] proceso dato = " << dato
                  << "  (" << procesados << "/" << total_esperado << " procesados,"
                  << " buffer: " << buffer.size() << "/" << TAM_BUFFER << ")\n";
        mtx.unlock();                // sale de zona critica
        espacios_vacios.release();   // avisa que quedo un espacio libre para los sensores

        std::this_thread::sleep_for(std::chrono::milliseconds(400));
    }
}

int main() {
    std::cout << "=== Simulacion SIGET: Sensores de trafico (productor-consumidor) ===\n";
    std::cout << "Buffer compartido de tamano " << TAM_BUFFER
              << ", " << NUM_SENSORES << " sensores, 1 modulo de analisis.\n\n";

    // Se lanzan los 3 hilos al mismo tiempo: 2 sensores (productores)
    // y el modulo de analisis (consumidor). Todos corren de forma concurrente.
    std::thread s1(sensor, 1);
    std::thread s2(sensor, 2);
    std::thread analisis(modulo_analisis);

    // join() espera a que cada hilo termine antes de que el programa cierre
    s1.join();
    s2.join();
    analisis.join();

    std::cout << "\n=== Simulacion finalizada: todos los datos fueron procesados sin perdida ni corrupcion. ===\n";
    return 0;
}
